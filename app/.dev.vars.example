# Copy to .dev.vars and fill in. `wrangler types` reads this file so these
# optional secrets show up on Env.
ANTHROPIC_API_KEY=""
ENGINE_MCP_TOKEN=""
# Entra ID sign-in. Use a separate dev app registration with a
# http://localhost:5173/auth/callback redirect URI; these override the vars
# in wrangler.jsonc during local dev.
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
# Any long random string; signs the session cookie.
SESSION_SECRET=""
# OIT API store credentials (ActiveDirectory subscription) for alias->netid.
OIT_CONSUMER_KEY=""
OIT_CONSUMER_SECRET=""
# Google Calendar MCP (dev needs its own OAuth client with a
# http://localhost:5173/oauth/google/callback redirect URI).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APP_ORIGIN=""
