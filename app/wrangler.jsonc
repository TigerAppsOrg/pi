{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],

  "ai": { "binding": "AI", "remote": true },

  "durable_objects": {
    "bindings": [{ "name": "Pi", "class_name": "Pi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pi"] }],

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/auth/*", "/oauth/*"]
  },

  "vars": {
    "ENGINE_MCP_BASE": "https://junction-engine.tigerapps.org",
    // OAuth client identifiers are public by design; the secret is a Worker secret.
    "ENTRA_TENANT_ID": "2ff60116-7431-425d-b5af-077d7791bda4",
    "ENTRA_CLIENT_ID": "ad41fa25-b30a-495e-a3bb-56ce2464f106",
    "OIT_AD_BASE": "https://api.princeton.edu/active-directory/1.0.6",
    "APP_ORIGIN": "https://pi.tigerapps.org",
    // Public OAuth client id from the Google Cloud project; the secret is a Worker secret.
    "GOOGLE_OAUTH_CLIENT_ID": "548956142814-upcmsgqr9pbafnlsorhimvje1negt5lm.apps.googleusercontent.com"
  },

  "observability": { "enabled": true }
}
